# Copy to .env and fill in values for local development.
# cp .env.example .env

# API
PORT=3001
SESSION_SECRET=change-me-in-production
ADMIN_KEY=dev-admin-change-me

# Frontend URL (Stripe redirects, email links)
APP_BASE_URL=http://localhost:5173

# PostgreSQL (default local install)
PGHOST=localhost
PGPORT=5432
PGDATABASE=eduspmhub
PGUSER=postgres
PGPASSWORD=postgres

# Stripe (test keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional — without these, booking emails log to the API console)
RESEND_API_KEY=
MAIL_FROM=EduSPM Hub <onboarding@yourdomain.com>

# Production only
# CORS_ORIGINS=https://app.example.com
